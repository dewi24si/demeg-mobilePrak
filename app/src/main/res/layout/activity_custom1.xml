<?xml version="1.0" encoding="utf-8"?>
<!--
    Pertemuan 6 – activity_custom1.xml
    Perubahan: Tambah MaterialToolbar, hapus btnBack (diganti Toolbar back)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ── TOOLBAR ──────────────────────────────────────────── -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/colorPrimaryLight"
        app:navigationIconTint="@color/white"
        app:popupTheme="@style/ThemeOverlay.Material3.Light" />

    <!-- ── KONTEN ────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/colorBackground"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ── HERO BANNER ──────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:background="@color/colorHero1"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌸"
                android:textSize="60sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bunga Anggrek"
                android:textColor="@color/colorTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvPageDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deskripsi halaman"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/colorPrimary"
            android:alpha="0.4" />

        <!-- ── CONTENT CARDS ────────────────────────── -->

        <!-- Tentang Anggrek -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/colorCard"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/colorInputBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖  Tentang Anggrek"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Anggrek (Orchidaceae) adalah keluarga tanaman berbunga terbesar di dunia dengan lebih dari 28.000 spesies yang diakui. Keindahan dan keragaman bentuk bunganya menjadikannya salah satu tanaman hias paling diminati secara global."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.6" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fakta Menarik -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/colorCard"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/colorInputBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨  Fakta Menarik"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Fakta 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌿" android:textSize="16sp" android:layout_marginEnd="10dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Indonesia memiliki lebih dari 5.000 spesies anggrek alam, menjadikannya salah satu pusat keanekaragaman anggrek di dunia."
                        android:textColor="@color/colorTextSecondary" android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>

                <!-- Fakta 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⏳" android:textSize="16sp" android:layout_marginEnd="10dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Beberapa jenis anggrek dapat mekar selama 2–6 bulan penuh tanpa henti."
                        android:textColor="@color/colorTextSecondary" android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>

                <!-- Fakta 3 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏺" android:textSize="16sp" android:layout_marginEnd="10dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vanilla planifolia, sumber bahan rempah vanilla, adalah spesies anggrek yang paling dikenal secara komersial."
                        android:textColor="@color/colorTextSecondary" android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Jenis Populer -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/colorCard"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/colorInputBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌺  Jenis Anggrek Populer"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌸  Phalaenopsis (Anggrek Bulan)"
                    android:textColor="@color/colorAccent" android:textSize="13sp"
                    android:textStyle="bold" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Anggrek paling populer sebagai tanaman hias rumah, mudah dirawat, berbunga sepanjang tahun."
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                    android:lineSpacingMultiplier="1.5" android:layout_marginBottom="10dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌸  Dendrobium"
                    android:textColor="@color/colorAccent" android:textSize="13sp"
                    android:textStyle="bold" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Genus terbesar kedua anggrek dengan lebih dari 1.800 spesies, banyak ditemukan di hutan tropis Asia."
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                    android:lineSpacingMultiplier="1.5" android:layout_marginBottom="10dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌸  Cattleya"
                    android:textColor="@color/colorAccent" android:textSize="13sp"
                    android:textStyle="bold" android:layout_marginBottom="2dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Sering disebut Ratu Anggrek karena keindahan bunganya yang besar, harum, dan berwarna cerah."
                    android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    </ScrollView>

</LinearLayout>