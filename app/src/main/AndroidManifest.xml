<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Pertemuan 13: Kamera -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Demegflower">

        <!-- Pertemuan 13: FileProvider untuk simpan hasil foto kamera -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ReminderReceiver untuk AlarmManager -->
        <receiver
            android:name=".utils.ReminderReceiver"
            android:exported="false" />

        <!-- LAUNCHER: SplashActivity -->
        <activity
            android:name=".pertemuan_6.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Demegflower">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false" />

        <!-- Pertemuan 7: BaseActivity (BottomNavigation) -->
        <activity
            android:name=".BaseActivity"
            android:exported="false" />

        <!-- Pertemuan 9: NinthActivity -->
        <activity
            android:name=".pertemuan_9.NinthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 9: ListView demo (ArrayAdapter / SimpleAdapter / CustomAdapter) -->
        <activity android:name=".pertemuan_9.InformasiListActivity" android:exported="false" />
        <activity android:name=".pertemuan_9.FaqListActivity" android:exported="false" />
        <activity android:name=".pertemuan_9.KontakListActivity" android:exported="false" />

        <!-- Pertemuan 10: TenthActivity -->
        <activity
            android:name=".pertemuan_10.TenthActivity"
            android:exported="false" />

        <!-- Pertemuan 13: ThirteenthActivity (Kamera, QR Generate, QR Scan) -->
        <activity
            android:name=".pertemuan_13.ThirteenthActivity"
            android:exported="false" />

        <!-- Pertemuan 6: WebViewActivity -->
        <activity
            android:name=".pertemuan_6.WebViewActivity"
            android:exported="false" />

        <!-- Pertemuan 3: Login -->
        <activity
            android:name=".pertemuan_3.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".pertemuan_3.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".pertemuan_3.VerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".pertemuan_3.WelcomeActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan_4.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan_4.BangunRuangActivity"
            android:exported="false" />

        <activity
            android:name=".pertemuan_4.CustomActivity1"
            android:exported="false" />

        <activity
            android:name=".pertemuan_4.CustomActivity2"
            android:exported="false" />

        <activity
            android:name=".pertemuan_2.MainActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Pertemuan 12: Room - Info Warga Form -->
        <activity
            android:name=".info.WargaFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 12: Room - Pengumuman Form -->
        <activity
            android:name=".pengumuman.PengumumanFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>
</manifest>
